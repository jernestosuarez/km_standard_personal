{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:glassity:contract:tenant-provisioning:deployment-binding:schema:v1",
  "title": "Glassity tenant deployment binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "binding_revision",
    "tenant_id",
    "deployment_id",
    "canonical_commit",
    "overlay_revision",
    "operator_profile_ref",
    "tenant_policy_refs",
    "approval_record",
    "repository",
    "operational_region",
    "lifecycle",
    "legal_hold",
    "erasure_map",
    "created_at",
    "effective_at",
    "lifecycle_evidence_ref"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "binding_id": {"type": "string", "minLength": 1},
    "binding_revision": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "deployment_id": {"type": "string", "minLength": 1},
    "canonical_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "overlay_revision": {"type": "string", "minLength": 1},
    "operator_profile_ref": {"type": "string", "minLength": 1},
    "tenant_policy_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "approval_record": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository_id", "approved_refs"],
      "properties": {
        "provider": {"const": "github"},
        "repository_id": {"type": "string", "minLength": 1},
        "approved_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^refs/(heads|tags)/[^\\s]+$"}
        }
      }
    },
    "operational_region": {"const": "eu-west-1"},
    "lifecycle": {
      "enum": [
        "active",
        "frozen",
        "deletion_executing",
        "completion_pending",
        "complete"
      ]
    },
    "legal_hold": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "decision_ref",
            "scope_digest",
            "legal_basis_ref",
            "review_date"
          ],
          "properties": {
            "status": {"const": "scoped"},
            "decision_ref": {"type": "string", "minLength": 1},
            "scope_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "legal_basis_ref": {"type": "string", "minLength": 1},
            "review_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
          }
        }
      ]
    },
    "erasure_map": {
      "$ref": "urn:glassity:contract:tenant-provisioning:erasure-map:schema:v1"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "effective_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "lifecycle_evidence_ref": {"type": "string", "minLength": 1}
  }
}
