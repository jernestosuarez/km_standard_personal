{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:glassity:contract:tenant-provisioning:inbound-envelope:schema:v1",
  "title": "Glassity inbound envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_namespace",
    "envelope_id",
    "tenant_id",
    "deployment_id",
    "envelope_type",
    "source",
    "actor_service_id",
    "created_at",
    "provenance",
    "classification",
    "classification_policy_ref",
    "idempotency_key",
    "destination"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_namespace": {"const": "glassity.inbound-envelope.v1"},
    "envelope_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {"type": "string", "minLength": 1},
    "deployment_id": {"type": "string", "minLength": 1},
    "envelope_type": {"enum": ["upload_pointer", "domain_event"]},
    "source": {"$ref": "#/$defs/pointer"},
    "actor_service_id": {"type": "string", "minLength": 1},
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "provenance": {
      "oneOf": [
        {"$ref": "#/$defs/resolved_provenance"},
        {"$ref": "#/$defs/unknown_provenance"}
      ]
    },
    "classification": {"type": "string", "minLength": 1},
    "classification_policy_ref": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "destination": {
      "type": "string",
      "pattern": "^_inbox/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.json$"
    },
    "extract": {"$ref": "#/$defs/extract"},
    "domain_assertion": {"$ref": "#/$defs/domain_assertion"}
  },
  "oneOf": [
    {
      "properties": {"envelope_type": {"const": "upload_pointer"}},
      "not": {"required": ["domain_assertion"]}
    },
    {
      "properties": {"envelope_type": {"const": "domain_event"}},
      "required": ["domain_assertion"],
      "not": {"required": ["extract"]}
    }
  ],
  "$defs": {
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "object_id",
        "version_id",
        "content_sha256",
        "resolver_ref",
        "owning_region_or_system"
      ],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "minLength": 1},
        "version_id": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "resolver_ref": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"}
        },
        "owning_region_or_system": {"type": "string", "minLength": 1}
      }
    },
    "resolved_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_status", "source_date", "date_kind"],
      "properties": {
        "date_status": {"const": "resolved"},
        "source_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "date_kind": {"enum": ["document", "event", "version"]}
      }
    },
    "unknown_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_status", "reason"],
      "properties": {
        "date_status": {"const": "unknown"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "extract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_type",
        "content_transfer_encoding",
        "classification",
        "classification_policy_ref",
        "text",
        "utf8_byte_length",
        "sha256"
      ],
      "properties": {
        "content_type": {"const": "text/plain; charset=utf-8"},
        "content_transfer_encoding": {"const": "identity"},
        "classification": {"type": "string", "minLength": 1},
        "classification_policy_ref": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "utf8_byte_length": {"type": "integer", "minimum": 0, "maximum": 65536},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "domain_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "classification", "classification_policy_refs"],
      "properties": {
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "claim_candidate": {"type": "string", "minLength": 1},
        "decision_ref": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "minLength": 1},
        "classification_policy_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
